# The server's settings: /opt/health-review/.env (owner deploy, mode 600). Placeholders only; real values stay on the
# server. Never commit the real file or put it in GitHub. compose.yml already fixes DATA_DIR=/app/data, HOST=0.0.0.0,
# PORT=5188 and TRUST_PROXY=1 for the container, so they are not needed here.

# The public addresses Caddy serves and gets certificates for (no https://, no path).
SITE_ADDRESS=health.example.com
DEMO_SITE_ADDRESS=demohealth.example.com

# Google sign-in (the Web application client). The server refuses to start without all of these, or without an https
# PUBLIC_URL. The client's authorized redirect URI is PUBLIC_URL + /auth/google/callback.
AUTH_MODE=google
PUBLIC_URL=https://health.example.com
# The first address is the owner (user 1, administrator). Anyone else signs in, requests access and waits for approval.
AUTH_ALLOWED_EMAILS=you@example.com
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# A fresh secret for the server: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Users (multi-user): seals each user's Claude API key (tools/secret-box.js). Make it once and keep it: changing it makes
# saved keys unreadable (users then enter them again). 48 random bytes in base64, like SESSION_SECRET, but a different one.
USER_KEY_SECRET=
# Email for registrations (to you) and approvals (to them): your Gmail address and a Google app password
# (myaccount.google.com/apppasswords, needs 2-Step Verification). ADMIN_EMAIL defaults to the owner's address.
SMTP_USER=
SMTP_APP_PASSWORD=
#ADMIN_EMAIL=

# Every date, the review week and the schedule are in this zone.
OWNER_TZ=America/New_York

# Apple Health arrives as Health Auto Export's REST posts (POST /api/ingest/health and /api/ingest/workouts) with the
# header Authorization: Bearer <INGEST_TOKEN>; no Drive folder is read. A long random token, rotated by changing it here
# and in the Health Auto Export automations.
APPLE_SOURCE=rest
INGEST_TOKEN=

# The Google Desktop client (Workout Log sheet, encrypted Drive backup); its token file goes in data/google/token.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORKOUT_LOG_SHEET_ID=

# The weekly review (and the Next program chat).
ANTHROPIC_API_KEY=
#REVIEW_MODEL=claude-opus-5-5
#REVIEW_EFFORT=high

# The same passphrase as the PC's, so earlier backups stay readable. Keep it in your password manager too.
HEALTH_BACKUP_PASSPHRASE=

# The in-app schedule (owner's time zone). Turn these on at cutover, and turn the Windows tasks off at the same time:
# never run both.
#SCHEDULE_SYNC=daily 07:00
#SCHEDULE_REVIEW=Sun,Mon,Tue 08:00 | Sun 13:00
#SCHEDULE_BACKUP=daily 23:00
#SCHEDULE_RESTORE_TEST=monthly 1 05:00

# Optional: a different image (a fork) instead of ghcr.io/scottmroth5/health-review.
#IMAGE=ghcr.io/<owner>/health-review

# The support address published on the policies, guides, Help, sign-in pages and emails to users (never in the repo).
SUPPORT_EMAIL=support@example.com
