# HTTPS in front of the app and the demo. Caddy gets free Let's Encrypt certificates for both addresses on first start
# (the DNS records must already point at the server, and ports 80 and 443 must be open) and renews them on its own; plain
# http requests are redirected to https. The app sets its own security headers, including HSTS (server/security.js);
# Caddy adds compression and forwards.

{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy app:5188 {
		# Sync now and the review run can take a few minutes; keep slow responses from being cut off.
		transport http {
			read_timeout 5m
		}
	}
	# No access log: the app keeps its own records to counts only, and request lines are not worth keeping.
}

# The public demo: made-up data only, read-only, kept out of search engines.
{$DEMO_SITE_ADDRESS} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy demo:5188
}
