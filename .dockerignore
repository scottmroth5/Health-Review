# Health data and secrets never enter the image (the same rules as .gitignore and the hard rules, enforced again here).
.env
.env.*
data/
*.pem
*.hrbk
*.csv
*.xml
client_secret*.json
token*.json
MAPS*
**/MAPS*

# The Terraform (v3 Phase 1F): the servers never need it, and a working copy holds the owner's terraform.tfvars,
# backend.hcl and provider binaries (.terraform/), which must never reach an image.
infra/
*.tfvars
*.tfstate*
.terraform/

# Not needed to run the server, or rebuilt inside the image.
# .cache/: CI's image scan (Trivy) keeps its vulnerability database in the workspace's .cache/trivy, and the published
# images are built after the scan from that same workspace; without this line the database (hundreds of MB) went into
# the image and the server's disk filled on deploy (2026-11-17).
.cache/
**/.cache/
node_modules/
.git/
.githooks/
.github/
legacy/
deploy/
evals/fixtures/v1/
Dockerfile
.dockerignore
