{
  "name": "health-review",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Weekly health review agent",
  "scripts": {
    "test": "node --test",
    "google:login": "node --env-file=.env scripts/google-login.js",
    "google:check": "node --env-file=.env scripts/google-check.js",
    "google:exports": "node --env-file=.env scripts/google-exports.js",
    "sync": "node --env-file=.env scripts/sync.js",
    "start": "node --env-file=.env server/index.js",
    "server:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-server.ps1",
    "server:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-server.ps1",
    "prompts:import-v1": "node scripts/import-v1-prompts.js",
    "metrics": "node scripts/metrics.js",
    "review": "node --env-file=.env scripts/review.js",
    "evals": "node scripts/evals.js",
    "evals:safety": "node --env-file=.env evals/run-safety-eval.mjs",
    "log:normalize": "node scripts/log-normalize.js",
    "log:unmapped": "node --env-file=.env scripts/log-unmapped.js",
    "log:typos": "node scripts/log-typos.js",
    "fix:session-times": "node scripts/fix-session-times.js",
    "programs:detect": "node scripts/programs-detect.js",
    "programs:review": "node scripts/programs-review.js",
    "programs:catalog": "node scripts/programs-catalog.js",
    "backup": "node --env-file=.env scripts/backup.js",
    "backup:restore": "node --env-file=.env scripts/backup-restore.js",
    "demo:build": "node demo/generate.js",
    "demo": "node server/demo.js",
    "check:personal": "node scripts/check-personal.js",
    "prepare": "node -e \"try{require('fs').existsSync('.git')&&require('child_process').execFileSync('git',['config','core.hooksPath','.githooks'],{stdio:'ignore'})}catch{}\"",
    "backup:test": "node --env-file=.env scripts/backup-verify.js",
    "db:pending": "node scripts/migrations-pending.js",
    "check:security": "node scripts/security-check.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@googleapis/sheets": "^18.1.2",
    "@scottmroth5/agent-core": "github:scottmroth5/Agent-Core#semver:^0.3.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.3",
    "maxmind": "^5.0.8",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
